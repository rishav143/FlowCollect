# Backend API base URL
VITE_API_URL=http://localhost:8080

# App frontend URL — used for landing page CTA links and domain redirect guard
# Dev: http://localhost:3000 | Prod: https://app.flowcollect.io
VITE_APP_URL=http://localhost:3000

# Marketing site URL — used for domain redirect guard
# Dev: http://localhost:3000 | Prod: https://www.flowcollect.io
VITE_MARKETING_URL=http://localhost:3000

# Set to "true" to use in-memory mocks instead of real API (UI-only dev)
# Set to "false" (or remove) to hit the real backend
VITE_USE_MOCK=false
